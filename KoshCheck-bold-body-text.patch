diff --git a/src/styles/base.css b/src/styles/base.css
--- a/src/styles/base.css
+++ b/src/styles/base.css
@@ -130,3 +130,15 @@
 .skip-link:focus {
   top: var(--space-3);
 }
+
+/*
+  Pertegas seluruh teks halaman agar tetap terbaca di atas background.
+  Heading dan seluruh isi di dalam heading sengaja tidak disentuh.
+  Hanken Grotesk Variable mendukung bobot 600 (semibold).
+*/
