diff --git a/src/styles/galaksi.css b/src/styles/galaksi.css
new file mode 100644
index 0000000..f123ad1
--- /dev/null
+++ b/src/styles/galaksi.css
@@ -0,0 +1,141 @@
+/*
+  Tema GALAKSI
+  ------------
+  Dipasang lewat atribut  <html data-theme="galaksi">  di index.html.
+  Hapus atribut itu untuk kembali ke tema terang bawaan (tokens.css).
+
+  Isi file ini:
+  1. Token: palet "langit malam" yang menggantikan nilai di tokens.css.
+     Catatan penamaan: di tema ini --ink = warna bintang (terang) dan
+     --paper = langit (gelap), jadi tombol/lencana yang tadinya "tinta gelap
+     di atas kertas" menjadi "bintang terang di atas langit".
+  2. Atmosfer: nebula, jalur bima sakti, bintang, dan siluet kos di cakrawala.
+     Semuanya layer fixed di belakang konten dan tidak menangkap klik.
+
+  Palet tetap berakar di merek: teal tua KOSCHECK menjadi warna nebula,
+  dan kuning penanda surveyor menjadi warna bintang emas.
+*/
+
+:root[data-theme='galaksi'] {
+  color-scheme: dark;
+
+  /* Warna dasar */
+  --ink: #e9efff; /* cahaya bintang: teks dan garis utama */
+  --ink-soft: #c5cff5;
+  --paper: #050b1d; /* ruang angkasa */
+  --paper-sunk: #0b1531;
+  --white: #0c1634; /* permukaan kartu dan panel */
+  --line: rgba(160, 181, 255, 0.22);
+  --line-sunk: rgba(160, 181, 255, 0.26);
+  --muted: #a2afe0;
+  --on-ink-mute: #49538a; /* teks redup di atas permukaan terang (--ink) */
+
+  /* Status hasil survei: pastel gelap, teks terang */
+  --ok: #5be3a1;
+  --ok-bg: rgba(56, 205, 140, 0.16);
+  --warn: #ffd35c;
+  --warn-bg: rgba(246, 195, 36, 0.16);
+  --bad: #ff948a;
+  --bad-bg: rgba(255, 105, 92, 0.18);
+
+  /* Token peran */
+  --on-marker: #151336;
+  --edge: rgba(176, 194, 255, 0.42);
+  --logo-bg: var(--marker);
+  --logo-fg: var(--on-marker);
+
+  --band: #060d28;
+  --band-bg: linear-gradient(135deg, #0d1a4a 0%, #1b1465 58%, #0b3b4a 100%);
+  --on-band: #f1f4ff;
+  --on-band-mute: #b7c3ee;
+  --band-line: rgba(183, 195, 238, 0.28);
+
+  --scrim: rgba(2, 5, 18, 0.78);
+  --stamp-blend: normal;
+  --rim-glow: drop-shadow(0 -2px 6px rgba(246, 195, 36, 0.55)) drop-shadow(0 -8px 26px rgba(31, 143, 134, 0.6));
+
+  /* Bayangan diganti pendar tipis */
+  --shadow-sheet:
+    0 0 0 1px rgba(163, 182, 255, 0.07), 0 24px 48px -24px rgba(0, 0, 0, 0.85),
+    0 0 56px -28px rgba(106, 79, 224, 0.6);
+}
+
+/* ---------- Atmosfer ---------- */
+
+/* z -3: nebula, jalur bima sakti, dan bintang statis */
+:root[data-theme='galaksi'] body::after {
+  content: '';
+  position: fixed;
+  inset: 0;
+  z-index: -3;
+  pointer-events: none;
+  background-image:
+    radial-gradient(72rem 46rem at 90% -10%, rgba(98, 72, 226, 0.36), transparent 62%),
+    radial-gradient(58rem 42rem at -10% 48%, rgba(24, 150, 140, 0.26), transparent 64%),
+    radial-gradient(62rem 38rem at 60% 114%, rgba(98, 72, 226, 0.24), transparent 62%),
+    /* jalur bima sakti: pita cahaya miring yang sangat tipis */
+      linear-gradient(
+        118deg,
+        transparent 34%,
+        rgba(150, 165, 255, 0.07) 46%,
+        rgba(235, 240, 255, 0.11) 50%,
+        rgba(150, 165, 255, 0.07) 54%,
+        transparent 66%
+      ),
+    url('./galaksi/bintang-dekat.svg'), url('./galaksi/bintang-jauh.svg');
+  background-size:
+    100% 100%,
+    100% 100%,
+    100% 100%,
+    100% 100%,
+    660px 660px,
+    420px 420px;
+  background-repeat: no-repeat, no-repeat, no-repeat, no-repeat, repeat, repeat;
+}
+
+/* z -2: kilau berujung empat yang berkedip pelan, dua layer dengan ritme berbeda */
+:root[data-theme='galaksi'] #top::before,
+:root[data-theme='galaksi'] #top::after {
+  content: '';
+  position: fixed;
+  inset: 0;
+  z-index: -2;
+  pointer-events: none;
+  opacity: 0.85;
+}
+
+:root[data-theme='galaksi'] #top::before {
+  background: url('./galaksi/kilau-a.svg') 0 0 / 940px 760px repeat;
+}
+
+:root[data-theme='galaksi'] #top::after {
+  background: url('./galaksi/kilau-b.svg') 0 0 / 1130px 880px repeat;
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  :root[data-theme='galaksi'] #top::before {
+    animation: kedip 7s ease-in-out infinite alternate;
+  }
+
+  :root[data-theme='galaksi'] #top::after {
+    animation: kedip 11s 2s ease-in-out infinite alternate;
+  }
+
+  @keyframes kedip {
+    from {
+      opacity: 0.15;
+    }
+    to {
+      opacity: 0.95;
+    }
+  }
+}
+
+/*
+  z -1: siluet kos di cakrawala. Memakai ilustrasi yang sama dengan tema terang,
+  digelapkan jadi biru malam supaya terlihat seperti kompleks kos di bawah langit berbintang.
+*/
+:root[data-theme='galaksi'] body::before {
+  opacity: 0.95;
+  filter: brightness(0.17) saturate(0.55) sepia(1) hue-rotate(178deg) saturate(2.4);
+}
