+.page {
+  min-height: 100dvh;
+  padding-block: var(--space-6) var(--space-8);
+}
+
+.top {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: var(--space-4);
+  margin-bottom: var(--space-5);
+}
+
+.kicker {
+  font-size: var(--step--1);
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  color: var(--muted);
+}
+
+.title {
+  font-size: var(--step-3);
+}
+
+.sub {
+  margin-top: var(--space-1);
+  font-size: var(--step--1);
+  color: var(--muted);
+}
+
+.topActions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+}
+
+.notice {
+  display: grid;
+  gap: var(--space-3);
+  justify-items: start;
+  max-width: 36rem;
+  padding: var(--space-5);
+  background: var(--white);
+  border: 2px solid var(--ink);
+  border-radius: var(--radius-m);
+}
+
+.error {
+  margin-bottom: var(--space-4);
+  padding: var(--space-3);
+  background: var(--bad-bg);
+  border-radius: var(--radius-s);
+  font-size: var(--step--1);
+  font-weight: 600;
+  color: var(--bad);
+}
+
+.stats {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
+  gap: var(--space-3);
+  margin-bottom: var(--space-6);
+}
+
+.stat {
+  padding: var(--space-4);
+  background: var(--white);
+  border: 2px solid var(--ink);
+  border-radius: var(--radius-m);
+}
+
+.stat dt {
+  font-size: var(--step--1);
+  font-weight: 650;
+  color: var(--muted);
+}
+
+.stat dd {
+  margin-top: var(--space-1);
+  font-family: var(--font-display);
+  font-size: var(--step-3);
+  font-weight: 750;
+  line-height: 1.1;
+}
+
+.statNote {
+  margin-top: var(--space-1);
+  font-size: var(--step--1);
+  font-weight: 650;
+  color: var(--ok);
+}
+
+.block {
+  margin-bottom: var(--space-7);
+}
+
+.blockHead {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3);
+  margin-bottom: var(--space-3);
+}
+
+.h2 {
+  font-size: var(--step-2);
+}
+
+.filters {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-1);
+  padding: var(--space-1);
+  background: var(--paper-sunk);
+  border-radius: var(--radius-m);
+}
+
+.filter {
+  padding: 0.5rem 0.85rem;
+  background: transparent;
+  border: 0;
+  border-radius: calc(var(--radius-m) - 3px);
+  font-size: var(--step--1);
+  font-weight: 650;
+  cursor: pointer;
+}
+
+.filter[aria-pressed='true'] {
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.scroll {
+  overflow-x: auto;
+  background: var(--white);
+  border: 2px solid var(--ink);
+  border-radius: var(--radius-m);
+}
+
+.table {
+  width: 100%;
+  min-width: 56rem;
+  border-collapse: collapse;
+  font-size: var(--step--1);
+}
+
+.table th,
+.table td {
+  padding: 0.65rem 0.85rem;
+  text-align: left;
+  vertical-align: top;
+  border-bottom: 1px solid var(--line);
+}
+
+.table th {
+  background: var(--paper-sunk);
+  font-weight: 700;
+  white-space: nowrap;
+}
+
+.table tbody tr:last-child td {
+  border-bottom: 0;
+}
+
+.nowrap {
+  white-space: nowrap;
+}
+
+.wrap {
+  max-width: 18rem;
+  overflow-wrap: anywhere;
+}
+
+.cell2 {
+  display: block;
+  margin-top: 0.15rem;
+  color: var(--muted);
+  white-space: normal;
+}
+
+.badge {
+  display: inline-block;
+  padding: 0.15rem 0.6rem;
+  border-radius: var(--radius-pill);
+  font-size: 0.8125rem;
+  font-weight: 700;
+}
+
+.ok {
+  background: var(--ok-bg);
+  color: var(--ok);
+}
+
+.warn {
+  background: var(--warn-bg);
+  color: var(--warn);
+}
+
+.bad {
+  background: var(--bad-bg);
+  color: var(--bad);
+}
+
+.empty {
+  padding: var(--space-5);
+  background: var(--white);
+  border: 2px dashed var(--line);
+  border-radius: var(--radius-m);
+  color: var(--muted);
+}
