+/* ---------- Pemilik kos ---------- */
+
+/** Nomor WhatsApp -> digit saja, awalan 0 jadi 62. Dipakai mencocokkan akun pemilik dengan data kosnya. */
+export const normWa = (value) => {
+  const digits = String(value ?? '').replace(/\D/g, '')
+  return digits.startsWith('0') ? `62${digits.slice(1)}` : digits
+}
+
+export async function getOwnerByWa(env, wa) {
+  if (!usePostgres(env)) {
+    assertFileAllowed(env)
+    return (await readJson()).owners.find((o) => o.whatsapp === wa) ?? null
+  }
+  const sql = await getSql(env)
+  const [row] = await sql`select * from owners where whatsapp = ${wa}`
+  return row ?? null
+}
+
+export async function getOwnerById(env, id) {
+  if (!usePostgres(env)) {
+    assertFileAllowed(env)
+    return (await readJson()).owners.find((o) => o.id === id) ?? null
+  }
+  const sql = await getSql(env)
+  const [row] = await sql`select * from owners where id = ${id}`
+  return row ?? null
+}
+
+/** Akun baru selalu wajib ganti password (must_change). Nomor yang sudah punya akun mengembalikan akun lama. */
+export async function insertOwner(env, o) {
+  if (!usePostgres(env)) {
+    assertFileAllowed(env)
+    return updateJson((db) => {
+      const found = db.owners.find((x) => x.whatsapp === o.whatsapp)
+      if (found) return found
+      const row = { ...o, must_change: true, created_at: new Date().toISOString() }
+      db.owners.push(row)
+      return row
+    })
+  }
+  const sql = await getSql(env)
+  const [row] = await sql`
+    insert into owners (id, whatsapp, nama, pass_hash)
+    values (${o.id}, ${o.whatsapp}, ${o.nama}, ${o.pass_hash})
+    on conflict (whatsapp) do nothing
+    returning *`
+  return row ?? getOwnerByWa(env, o.whatsapp)
+}
+
+export async function setOwnerPassword(env, id, passHash) {
+  if (!usePostgres(env)) {
+    assertFileAllowed(env)
+    return updateJson((db) => {
+      const row = db.owners.find((o) => o.id === id)
+      if (row) Object.assign(row, { pass_hash: passHash, must_change: false })
+    })
+  }
+  const sql = await getSql(env)
+  await sql`update owners set pass_hash = ${passHash}, must_change = false where id = ${id}`
+}
+
+/** Semua kos yang nomor WhatsApp-nya (setelah dinormalkan) sama dengan wa. Isi: id, nama, whatsapp, owner_id. */
+export async function listingsByWa(env, wa) {
+  let rows
+  if (!usePostgres(env)) {
+    assertFileAllowed(env)
+    rows = (await readJson()).listings
+  } else {
+    const sql = await getSql(env)
+    rows = await sql`
+      select id, nama, whatsapp, owner_id from listings
+      where regexp_replace(whatsapp, '[^0-9]', '', 'g') like ${'%' + wa.slice(-8)}`
+  }
+  return rows.filter((r) => normWa(r.whatsapp) === wa)
+}
+
+export async function setListingsOwner(env, ids, ownerId) {
+  if (!usePostgres(env)) {
+    assertFileAllowed(env)
+    return updateJson((db) => {
+      for (const l of db.listings) if (ids.includes(l.id) && !l.owner_id) l.owner_id = ownerId
+    })
+  }
+  const sql = await getSql(env)
+  await sql`update listings set owner_id = ${ownerId} where id in ${sql(ids)} and owner_id is null`
+}
+
+/**
+ * Kos milik satu pemilik, terbaru di atas, dengan status pesanan survei:
+ * 'dipesan' (ada pesanan lunas), 'menunggu' (ada pesanan belum bayar), 'belum'.
+ * Pesanan dicocokkan lewat nama kos (orders.kos). Data pemesan tidak ikut.
+ */
+export async function listOwnerKos(env, ownerId) {
+  const key = (v) => String(v ?? '').trim().toLowerCase()
+  let listings
+  let orders
+  if (!usePostgres(env)) {
+    assertFileAllowed(env)
+    const db = await readJson()
+    listings = db.listings.filter((l) => l.owner_id === ownerId).reverse()
+    orders = db.orders
+  } else {
+    const sql = await getSql(env)
+    listings = await sql`
+      select id, kos, area, tipe, harga, created_at from listings
+      where owner_id = ${ownerId} order by created_at desc`
+    orders = listings.length
+      ? await sql`select kos, status from orders where lower(trim(kos)) in ${sql(listings.map((l) => key(l.kos)))}`
+      : []
+  }
+  return listings.map((l) => {
+    const mine = orders.filter((o) => key(o.kos) === key(l.kos))
+    const status = mine.some((o) => o.status === 'paid') ? 'dipesan' : mine.some((o) => o.status === 'pending') ? 'menunggu' : 'belum'
+    return { id: l.id, kos: l.kos, area: l.area, tipe: l.tipe, harga: l.harga, created_at: l.created_at, status }
+  })
+}
diff --git a/api/_owner.js b/api/_owner.js
new file mode 100644
index 0000000..d9f77ac
--- /dev/null
+++ b/api/_owner.js
@@ -0,0 +1,55 @@
+/*
+  Bantuan login pemilik kos (dipakai api/owner.js). Berawalan "_" jadi bukan endpoint.
+  - Password disimpan sebagai hash scrypt (garam acak per akun), bukan teks biasa.
+  - Token sesi bertanda tangan HMAC, 2 jam. Kuncinya diturunkan dari "owner:" + OWNER_SECRET (atau ADMIN_KEY),
+    jadi token pemilik TIDAK bisa dipakai sebagai token admin, dan sebaliknya.
+*/
+import { createHmac, randomBytes, scryptSync, timingSafeEqual } from 'node:crypto'
+import { sameSecret } from './_auth.js'
+
+const TOKEN_TTL_MS = 2 * 60 * 60 * 1000
+
+/** Password awal yang sama untuk semua pemilik. Ganti lewat env OWNER_DEFAULT_PASSWORD. */
+export const defaultPassword = (env) => env.OWNER_DEFAULT_PASSWORD || 'kosan12345'
+
+const secretOf = (env) => {
+  const base = env.OWNER_SECRET || env.ADMIN_KEY
+  return base ? `owner:${base}` : ''
+}
+export const ownerEnabled = (env) => Boolean(secretOf(env))
+
+export function hashPassword(password) {
+  const salt = randomBytes(16).toString('hex')
+  return `${salt}:${scryptSync(String(password), salt, 32).toString('hex')}`
+}
+
+export function checkPassword(password, stored) {
+  const [salt, hash] = String(stored ?? '').split(':')
+  if (!salt || !hash) return false
+  const given = scryptSync(String(password ?? ''), salt, 32)
+  const expected = Buffer.from(hash, 'hex')
+  return given.length === expected.length && timingSafeEqual(given, expected)
+}
+
+const sign = (payload, secret) => createHmac('sha256', secret).update(payload).digest('base64url')
+
+export function makeOwnerToken(env, ownerId, now = Date.now()) {
+  const expiresAt = now + TOKEN_TTL_MS
+  const payload = Buffer.from(JSON.stringify({ oid: ownerId, exp: expiresAt })).toString('base64url')
+  return { token: `${payload}.${sign(payload, secretOf(env))}`, expiresAt }
+}
+
+/** Id pemilik dari header Authorization: Bearer <token>, atau null bila tidak sah / kedaluwarsa. */
+export function ownerIdFromRequest(req, env) {
+  const secret = secretOf(env)
+  const token = /^Bearer\s+(\S+)$/i.exec(req?.headers?.authorization ?? '')?.[1]
+  if (!secret || !token) return null
+  const parts = token.split('.')
+  if (parts.length !== 2 || !sameSecret(parts[1], sign(parts[0], secret))) return null
+  try {
+    const { oid, exp } = JSON.parse(Buffer.from(parts[0], 'base64url').toString())
+    return typeof oid === 'string' && exp > Date.now() ? oid : null
+  } catch {
+    return null
+  }
+}
diff --git a/api/owner.js b/api/owner.js
new file mode 100644
index 0000000..6a8fd0b
--- /dev/null
+++ b/api/owner.js
@@ -0,0 +1,111 @@
+/*
+  Login dan data Pemilik Kos (Vercel Serverless Function). Satu endpoint untuk tiga aksi supaya jumlah
+  function di Vercel tidak bertambah banyak. Semuanya POST dengan body { action, ... }.
+
+    { action: 'login', whatsapp, password }       -> { token, expiresAt, mustChange, nama }
+    { action: 'data' }                            -> { owner: { nama, whatsapp, mustChange }, kos: [...] }
+    { action: 'password', password, newPassword } -> { ok: true }
+  'data' dan 'password' memakai header  Authorization: Bearer <token>  dari login.
+
+  Akun pemilik dibuat otomatis saat nomor WhatsApp-nya login pertama kali, bila nomor itu sudah ada di
+  data kos (listings). Password awalnya sama untuk semua (env OWNER_DEFAULT_PASSWORD) dan wajib diganti:
+  selama belum diganti, 'data' tidak mengembalikan kos sama sekali.
+  Pemilik hanya menerima kos miliknya (listings.owner_id). Data pemesan tidak ikut, hanya statusnya.
+*/
+import { clearFailures, clientIp, lockedMinutes, recordFailure, sameSecret } from './_auth.js'
+import {
+  getOwnerById, getOwnerByWa, insertOwner, listingsByWa, listOwnerKos, newId, normWa, setListingsOwner, setOwnerPassword,
+} from './_db.js'
+import { checkPassword, defaultPassword, hashPassword, makeOwnerToken, ownerEnabled, ownerIdFromRequest } from './_owner.js'
+
+const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms))
+const fail = (status, error) => ({ status, data: { error } })
+
+/** Hubungkan kos yang nomor WhatsApp-nya sama dengan akun ini (termasuk kos yang ditambah belakangan). */
+async function linkListings(env, owner) {
+  const free = (await listingsByWa(env, owner.whatsapp)).filter((l) => !l.owner_id).map((l) => l.id)
+  if (free.length) await setListingsOwner(env, free, owner.id)
+}
+
+async function login(body, env, req) {
+  const ip = `owner:${clientIp(req)}`
+  const menit = lockedMinutes(ip)
+  if (menit) return fail(429, `Terlalu banyak percobaan. Coba lagi dalam ${menit} menit.`)
+
+  const wa = normWa(body?.whatsapp)
+  const password = typeof body?.password === 'string' ? body.password.slice(0, 200) : ''
+
+  let owner = wa.length >= 8 ? await getOwnerByWa(env, wa) : null
+  if (!owner && wa.length >= 8) {
+    const kos = await listingsByWa(env, wa)
+    if (kos.length) {
+      owner = await insertOwner(env, { id: newId('OW'), whatsapp: wa, nama: kos[0].nama, pass_hash: hashPassword(defaultPassword(env)) })
+    }
+  }
+  if (!owner || !checkPassword(password, owner.pass_hash)) {
+    recordFailure(ip)
+    await wait(400)
+    return fail(401, 'Nomor WhatsApp atau password salah.')
+  }
+
+  clearFailures(ip)
+  await linkListings(env, owner)
+  return { status: 200, data: { ...makeOwnerToken(env, owner.id), mustChange: Boolean(owner.must_change), nama: owner.nama } }
+}
+
+async function currentOwner(env, req) {
+  const id = ownerIdFromRequest(req, env)
+  return id ? getOwnerById(env, id) : null
+}
+
+async function data(env, req) {
+  const owner = await currentOwner(env, req)
+  if (!owner) return fail(401, 'Belum masuk atau sesi sudah habis.')
+  await linkListings(env, owner)
+  const mustChange = Boolean(owner.must_change)
+  const kos = mustChange ? [] : await listOwnerKos(env, owner.id)
+  return { status: 200, data: { owner: { nama: owner.nama, whatsapp: owner.whatsapp, mustChange }, kos } }
+}
+
+async function changePassword(body, env, req) {
+  const owner = await currentOwner(env, req)
+  if (!owner) return fail(401, 'Belum masuk atau sesi sudah habis.')
+
+  const ip = `owner:${clientIp(req)}`
+  const menit = lockedMinutes(ip)
+  if (menit) return fail(429, `Terlalu banyak percobaan. Coba lagi dalam ${menit} menit.`)
+
+  const current = typeof body?.password === 'string' ? body.password.slice(0, 200) : ''
+  const next = typeof body?.newPassword === 'string' ? body.newPassword : ''
+  if (!checkPassword(current, owner.pass_hash)) {
+    recordFailure(ip)
+    return fail(400, 'Password saat ini salah.')
+  }
+  if (next.length < 8 || next.length > 200) return fail(400, 'Password baru minimal 8 karakter.')
+  if (sameSecret(next, current) || sameSecret(next, defaultPassword(env))) {
+    return fail(400, 'Password baru harus berbeda dari password awal.')
+  }
+
+  clearFailures(ip)
+  await setOwnerPassword(env, owner.id, hashPassword(next))
+  return { status: 200, data: { ok: true } }
+}
+
+export async function ownerApi(body, env, req) {
+  if (!ownerEnabled(env)) return fail(503, 'Login pemilik belum aktif. Isi ADMIN_KEY atau OWNER_SECRET di env.')
+  try {
+    if (body?.action === 'login') return await login(body, env, req)
+    if (body?.action === 'data') return await data(env, req)
+    if (body?.action === 'password') return await changePassword(body, env, req)
+    return fail(400, 'Aksi tidak dikenal.')
+  } catch (err) {
+    console.error('[owner]', err)
+    return fail(500, 'Terjadi masalah di server. Coba lagi sebentar.')
+  }
+}
+
+export default async function handler(req, res) {
+  if (req.method !== 'POST') return res.status(405).json({ error: 'Gunakan POST.' })
+  const { status, data } = await ownerApi(req.body, process.env, req)
+  res.status(status).json(data)
+}
