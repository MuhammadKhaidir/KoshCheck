+import { useId, useState } from 'react'
+import Container from '../components/ui/Container.jsx'
+import Button from '../components/ui/Button.jsx'
+import { saveToken as saveAdminToken } from '../lib/adminSession.js'
+import { saveOwnerToken } from '../lib/ownerSession.js'
+import s from './AdminPage.module.css'
+import a from './Auth.module.css'
+
+/*
+  Halaman masuk (#/masuk), dibuka dari tombol "Masuk" di header. Dua jalur: Pemilik Kos dan Admin.
+  Password dikirim langsung ke server (/api/owner atau /api/admin-login), tidak lewat chat AI.
+*/
+async function post(url, body) {
+  const res = await fetch(url, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body),
+  })
+  const data = await res.json().catch(() => ({}))
+  if (!res.ok || !data.token) throw new Error(data.error || 'Gagal masuk. Coba lagi sebentar.')
+  return data
+}
+
+function keep(save, token) {
+  try {
+    save(token)
+  } catch {
+    throw new Error('Browser menolak menyimpan sesi. Matikan mode privat, lalu coba lagi.')
+  }
+}
+
+export default function LoginPage() {
+  const uid = useId()
+  const [role, setRole] = useState('pemilik')
+  const [whatsapp, setWhatsapp] = useState('')
+  const [password, setPassword] = useState('')
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState('')
+
+  const pickRole = (next) => {
+    setRole(next)
+    setError('')
+    setPassword('')
+  }
+
+  async function submit(event) {
+    event.preventDefault()
+    if (busy) return
+    setBusy(true)
+    setError('')
+    try {
+      if (role === 'admin') {
+        const data = await post('/api/admin-login', { password })
+        keep(saveAdminToken, data.token)
+        window.location.hash = '#/admin'
+      } else {
+        const data = await post('/api/owner', { action: 'login', whatsapp, password })
+        keep(saveOwnerToken, data.token)
+        window.location.hash = '#/pemilik'
+      }
+    } catch (err) {
+      setError(err.message)
+      setPassword('')
+      setBusy(false)
+    }
+  }
+
+  return (
+    <main className={s.page}>
+      <Container>
+        <header className={s.top}>
+          <div>
+            <p className={s.kicker}>KOSCHECK</p>
+            <h1 className={s.title}>Masuk</h1>
+          </div>
+        </header>
+
+        <div className={a.card}>
+          <div className={a.tabs}>
+            <button type="button" className={a.tab} aria-pressed={role === 'pemilik'} onClick={() => pickRole('pemilik')}>
+              Pemilik Kos
+            </button>
+            <button type="button" className={a.tab} aria-pressed={role === 'admin'} onClick={() => pickRole('admin')}>
+              Admin
+            </button>
+          </div>
+
+          <form className={a.form} onSubmit={submit}>
+            {role === 'pemilik' && (
+              <div className={a.field}>
+                <label htmlFor={`${uid}-wa`}>Nomor WhatsApp</label>
+                <input
+                  id={`${uid}-wa`}
+                  className={a.input}
+                  type="tel"
+                  inputMode="tel"
+                  autoComplete="username"
+                  maxLength={20}
+                  placeholder="08xxxxxxxxxx"
+                  value={whatsapp}
+                  onChange={(e) => setWhatsapp(e.target.value)}
+                  required
+                />
+              </div>
+            )}
+            <div className={a.field}>
+              <label htmlFor={`${uid}-pw`}>Password</label>
+              <input
+                id={`${uid}-pw`}
+                className={a.input}
+                type="password"
+                autoComplete="current-password"
+                maxLength={200}
+                value={password}
+                onChange={(e) => setPassword(e.target.value)}
+                required
+              />
+            </div>
+            {role === 'pemilik' && (
+              <p className={a.hint}>
+                Pakai nomor WhatsApp yang didaftarkan untuk kosmu. Login pertama memakai password awal dari tim
+                KOSCHECK, lalu kamu diminta menggantinya.
+              </p>
+            )}
+            {error && (
+              <p className={a.error} role="alert">
+                {error}
+              </p>
+            )}
+            <Button as="button" type="submit" disabled={busy || !password}>
+              {busy ? 'Memeriksa…' : 'Masuk'}
+            </Button>
+          </form>
+
+          <Button as="a" variant="secondary" size="sm" href="#top">
+            Kembali ke situs
+          </Button>
+        </div>
+      </Container>
+    </main>
+  )
+}
diff --git a/src/pages/OwnerPage.jsx b/src/pages/OwnerPage.jsx
new file mode 100644
index 0000000..eb3fcad
--- /dev/null
+++ b/src/pages/OwnerPage.jsx
@@ -0,0 +1,233 @@
+import { useCallback, useEffect, useId, useState } from 'react'
+import Container from '../components/ui/Container.jsx'
+import Button from '../components/ui/Button.jsx'
+import { rupiah } from '../lib/format.js'
+import { clearOwnerToken, getOwnerToken } from '../lib/ownerSession.js'
+import s from './AdminPage.module.css'
+import a from './Auth.module.css'
+
+/*
+  Halaman Pemilik Kos (#/pemilik). Hanya menampilkan kos milik akun yang login, beserta status pesanannya.
+  Selama password awal belum diganti, server tidak mengirim data kos: yang tampil hanya form ganti password.
+*/
+const REFRESH_MS = 30000
+
+const STATUS = {
+  dipesan: { label: 'Sudah dipesan', tone: s.ok },
+  menunggu: { label: 'Menunggu pembayaran', tone: s.warn },
+  belum: { label: 'Belum dipesan', tone: a.plain },
+}
+
+async function call(body) {
+  const res = await fetch('/api/owner', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', authorization: `Bearer ${getOwnerToken()}` },
+    body: JSON.stringify(body),
+  })
+  const data = await res.json().catch(() => ({}))
+  return { res, data }
+}
+
+const FIELDS = [
+  ['password', 'Password saat ini (password awal)', 'current-password'],
+  ['newPassword', 'Password baru (minimal 8 karakter)', 'new-password'],
+  ['again', 'Ulangi password baru', 'new-password'],
+]
+
+function ChangePassword({ onDone }) {
+  const uid = useId()
+  const [form, setForm] = useState({ password: '', newPassword: '', again: '' })
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState('')
+
+  async function submit(event) {
+    event.preventDefault()
+    if (busy) return
+    if (form.newPassword.length < 8) return setError('Password baru minimal 8 karakter.')
+    if (form.newPassword !== form.again) return setError('Ulangi password baru dengan sama persis.')
+    setBusy(true)
+    setError('')
+    try {
+      const { res, data } = await call({ action: 'password', password: form.password, newPassword: form.newPassword })
+      if (!res.ok) throw new Error(data.error || 'Password belum bisa diganti.')
+      onDone()
+    } catch (err) {
+      setError(err.message)
+      setBusy(false)
+    }
+  }
+
+  return (
+    <div className={s.notice} role="alert">
+      <h2 className={s.h2}>Wajib ganti password</h2>
+      <p>Kamu masih memakai password awal. Ganti dulu dengan password baru sebelum melihat data kosmu.</p>
+      <form className={a.form} onSubmit={submit}>
+        {FIELDS.map(([key, label, autoComplete]) => (
+          <div className={a.field} key={key}>
+            <label htmlFor={`${uid}-${key}`}>{label}</label>
+            <input
+              id={`${uid}-${key}`}
+              className={a.input}
+              type="password"
+              autoComplete={autoComplete}
+              maxLength={200}
+              value={form[key]}
+              onChange={(e) => setForm((f) => ({ ...f, [key]: e.target.value }))}
+              required
+            />
+          </div>
+        ))}
+        {error && <p className={a.error}>{error}</p>}
+        <Button as="button" type="submit" disabled={busy}>
+          {busy ? 'Menyimpan…' : 'Simpan password baru'}
+        </Button>
+      </form>
+    </div>
+  )
+}
+
+export default function OwnerPage() {
+  const [state, setState] = useState(() => (getOwnerToken() ? 'loading' : 'nologin')) // loading | ready | nologin | error
+  const [owner, setOwner] = useState(null)
+  const [kos, setKos] = useState([])
+  const [error, setError] = useState('')
+
+  const load = useCallback(async () => {
+    if (!getOwnerToken()) return setState('nologin')
+    try {
+      const { res, data } = await call({ action: 'data' })
+      if (res.status === 401) {
+        clearOwnerToken()
+        return setState('nologin')
+      }
+      if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`)
+      setOwner(data.owner)
+      setKos(data.kos ?? [])
+      setError('')
+      setState('ready')
+    } catch (err) {
+      setError(err.message)
+      setState((prev) => (prev === 'ready' ? 'ready' : 'error'))
+    }
+  }, [])
+
+  useEffect(() => {
+    const oldTitle = document.title
+    document.title = 'Pemilik Kos | KOSCHECK'
+    window.scrollTo(0, 0)
+    load()
+    const timer = setInterval(load, REFRESH_MS)
+    return () => {
+      clearInterval(timer)
+      document.title = oldTitle
+    }
+  }, [load])
+
+  function logout() {
+    clearOwnerToken()
+    window.location.hash = '#top'
+  }
+
+  return (
+    <main className={s.page}>
+      <Container>
+        <header className={s.top}>
+          <div>
+            <p className={s.kicker}>KOSCHECK</p>
+            <h1 className={s.title}>Kos Saya</h1>
+            {owner && <p className={s.sub}>Masuk sebagai {owner.nama}.</p>}
+          </div>
+          <div className={s.topActions}>
+            {state === 'ready' && !owner?.mustChange && (
+              <Button as="button" variant="secondary" size="sm" onClick={load}>
+                Muat ulang
+              </Button>
+            )}
+            <Button as="a" variant="secondary" size="sm" href="#top">
+              Kembali ke situs
+            </Button>
+            {state !== 'nologin' && (
+              <Button as="button" size="sm" onClick={logout}>
+                Keluar
+              </Button>
+            )}
+          </div>
+        </header>
+
+        {state === 'loading' && (
+          <p className={s.notice} role="status">
+            Memuat data…
+          </p>
+        )}
+
+        {state === 'nologin' && (
+          <div className={s.notice}>
+            <p>Sesi tidak ada atau sudah habis. Silakan masuk lagi.</p>
+            <Button as="a" href="#/masuk">
+              Masuk
+            </Button>
+          </div>
+        )}
+
+        {state === 'error' && (
+          <div className={s.notice} role="alert">
+            <p>Data belum bisa dimuat: {error}</p>
+            <Button as="button" onClick={load}>
+              Coba lagi
+            </Button>
+          </div>
+        )}
+
+        {state === 'ready' && owner.mustChange && <ChangePassword onDone={load} />}
+
+        {state === 'ready' && !owner.mustChange && (
+          <section className={s.block} aria-labelledby="owner-kos">
+            <div className={s.blockHead}>
+              <h2 id="owner-kos" className={s.h2}>
+                Kos yang terdaftar atas nomor {owner.whatsapp}
+              </h2>
+            </div>
+            {error && (
+              <p className={s.error} role="alert">
+                Gagal memperbarui: {error}
+              </p>
+            )}
+            {kos.length === 0 ? (
+              <p className={s.empty}>Belum ada kos yang terhubung dengan akun ini.</p>
+            ) : (
+              <div className={s.scroll} role="region" aria-label="Tabel kos saya" tabIndex={0}>
+                <table className={s.table}>
+                  <thead>
+                    <tr>
+                      <th scope="col">Nama kos</th>
+                      <th scope="col">Area</th>
+                      <th scope="col">Tipe</th>
+                      <th scope="col">Harga / bulan</th>
+                      <th scope="col">Status pesanan</th>
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {kos.map((k) => {
+                      const st = STATUS[k.status] ?? STATUS.belum
+                      return (
+                        <tr key={k.id}>
+                          <td className={s.wrap}>{k.kos}</td>
+                          <td className={s.wrap}>{k.area}</td>
+                          <td>{k.tipe || '-'}</td>
+                          <td className={s.nowrap}>{k.harga ? rupiah(k.harga) : '-'}</td>
+                          <td>
+                            <span className={`${s.badge} ${st.tone}`}>{st.label}</span>
+                          </td>
+                        </tr>
+                      )
+                    })}
+                  </tbody>
+                </table>
+              </div>
+            )}
+          </section>
+        )}
+      </Container>
+    </main>
+  )
+}
