# Salin jadi .env.local (jangan di-commit), lalu isi key. Format wajib NAMA=NILAI, tanpa tanda kutip.
# Di Vercel: Project Settings > Environment Variables.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MODEL=anthropic/claude-haiku-5.5
# Boleh beberapa model dipisah koma (dicoba berurutan), contoh model gratis:
# AI_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free
# Kalau ada model :free, openrouter/free otomatis jadi cadangan terakhir.

# Database pesanan dan pendaftaran kos (Postgres: Supabase, Neon, Vercel Postgres, dll).
# Kosong di lokal = data disimpan ke file .data/koshcheck.json. Di Vercel wajib diisi.
DATABASE_URL=
# Password admin: untuk membuka halaman database lewat chat AI (ketik "buka database"), dan untuk curl
# ke GET /api/admin (header x-admin-key). Isi bebas, buatan sendiri, makin panjang makin aman.
# Kosong = halaman database nonaktif.
ADMIN_KEY=

# Pembayaran (Midtrans). Ambil di dashboard Midtrans > Settings > Access Keys.
# Pembayaran asli belum aktif. Simulasi hanya di lingkungan lokal dengan dua flag opt-in di bawah.
# Deployment Vercel/production dan konfigurasi Midtrans menolak endpoint simulasi.
# Biarkan MIDTRANS_IS_PRODUCTION=false selama uji coba (sandbox, tidak ada uang sungguhan).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Simulasi hanya untuk lokal. Jangan aktifkan di deployment.
ENABLE_DUMMY_PAYMENT=false
VITE_ENABLE_DUMMY_PAYMENT=false

# Admin membuat password awal unik dari listing terbit setelah memverifikasi pemilik.
# OWNER_DEFAULT_PASSWORD hanya untuk menolak pemakaian ulang password lama, bukan login awal.
OWNER_DEFAULT_PASSWORD=
# Kunci tanda tangan sesi pemilik. Kosong = diturunkan dari ADMIN_KEY (salah satunya harus terisi).
OWNER_SECRET=
