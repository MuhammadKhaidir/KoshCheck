# Salin jadi .env.local (jangan di-commit), lalu isi key. Format wajib NAMA=NILAI, tanpa tanda kutip.
# Di Vercel: Project Settings > Environment Variables.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MODEL=anthropic/claude-haiku-5.5
# Boleh beberapa model dipisah koma (dicoba berurutan), contoh model gratis:
# AI_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free
# Kalau ada model :free, openrouter/free otomatis jadi cadangan terakhir.

# Pembayaran (Midtrans). Ambil di dashboard Midtrans > Settings > Access Keys.
# Biarkan MIDTRANS_IS_PRODUCTION=false selama uji coba (sandbox, tidak ada uang sungguhan).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
