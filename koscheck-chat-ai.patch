+.root {
+  position: fixed;
+  right: var(--space-4);
+  bottom: var(--space-4);
+  z-index: 60;
+}
+
+.launcher {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-2);
+  min-height: 3rem;
+  padding: 0.85rem 1.2rem;
+  border: 2px solid var(--ink);
+  border-radius: var(--radius-m);
+  background: var(--marker);
+  color: var(--ink);
+  font-size: var(--step-0);
+  font-weight: 650;
+  line-height: 1.1;
+  cursor: pointer;
+  box-shadow: var(--shadow-sheet);
+  transition: background-color 0.15s ease;
+}
+
+.launcher:hover {
+  background: var(--marker-deep);
+}
+
+.panel {
+  display: flex;
+  flex-direction: column;
+  width: min(24rem, calc(100vw - 2 * var(--space-4)));
+  height: min(34rem, calc(100dvh - 2 * var(--space-4)));
+  overflow: hidden;
+  border: 2px solid var(--ink);
+  border-radius: var(--radius-m);
+  background: var(--paper);
+  box-shadow: var(--shadow-sheet);
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .panel {
+    animation: buka 0.18s ease-out;
+  }
+}
+
+@keyframes buka {
+  from {
+    opacity: 0;
+    transform: translateY(0.5rem);
+  }
+}
+
+.head {
+  --focus: var(--marker);
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: var(--space-3);
+  padding: var(--space-4);
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.title {
+  font-size: var(--step-1);
+  font-weight: 750;
+  letter-spacing: -0.02em;
+}
+
+.sub {
+  margin-top: var(--space-1);
+  font-size: var(--step--1);
+  color: var(--on-ink-mute);
+}
+
+.close {
+  display: grid;
+  place-items: center;
+  flex: none;
+  width: 2.5rem;
+  height: 2.5rem;
+  margin: -0.25rem -0.25rem 0 0;
+  border: 0;
+  border-radius: var(--radius-s);
+  background: transparent;
+  color: inherit;
+  cursor: pointer;
+}
+
+.close:hover {
+  background: rgba(244, 247, 245, 0.14);
+}
+
+.list {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: var(--space-3);
+  padding: var(--space-4);
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+
+.msg {
+  max-width: 85%;
+  padding: var(--space-3) var(--space-4);
+  border-radius: var(--radius-m);
+  font-size: 0.9375rem;
+  line-height: 1.45;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
+
+.bot {
+  align-self: flex-start;
+  border: 1px solid var(--line);
+  border-bottom-left-radius: var(--radius-s);
+  background: var(--white);
+}
+
+.me {
+  align-self: flex-end;
+  border-bottom-right-radius: var(--radius-s);
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.wait {
+  color: var(--muted);
+}
+
+.chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+}
+
+.chip {
+  min-height: 2.25rem;
+  padding: 0.4rem 0.75rem;
+  border: 1.5px solid var(--ink);
+  border-radius: var(--radius-s);
+  background: transparent;
+  font-size: 0.875rem;
+  font-weight: 600;
+  text-align: left;
+  cursor: pointer;
+  transition:
+    background-color 0.15s ease,
+    color 0.15s ease;
+}
+
+.chip:hover {
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.error {
+  padding: var(--space-3) var(--space-4);
+  border-radius: var(--radius-s);
+  background: var(--bad-bg);
+  color: var(--bad);
+  font-size: 0.9375rem;
+}
+
+.retry {
+  margin-top: var(--space-2);
+  padding: 0;
+  border: 0;
+  background: none;
+  color: inherit;
+  font-weight: 650;
+  text-decoration: underline;
+  cursor: pointer;
+}
+
+.form {
+  display: flex;
+  gap: var(--space-2);
+  padding: var(--space-3);
+  border-top: 1px solid var(--line);
+  background: var(--white);
+}
+
+.input {
+  flex: 1;
+  min-width: 0;
+  min-height: 2.75rem;
+  padding: 0 var(--space-3);
+  border: 2px solid var(--line);
+  border-radius: var(--radius-m);
+  background: var(--paper);
+}
+
+.input:focus {
+  border-color: var(--ink);
+}
+
+.send {
+  display: grid;
+  place-items: center;
+  flex: none;
+  width: 2.75rem;
+  height: 2.75rem;
+  border: 0;
+  border-radius: var(--radius-m);
+  background: var(--ink);
+  color: var(--paper);
+  cursor: pointer;
+}
+
+.send:disabled {
+  opacity: 0.45;
+  cursor: not-allowed;
+}
+
+.note {
+  padding: 0 var(--space-4) var(--space-3);
+  background: var(--white);
+  color: var(--muted);
+  font-size: 0.75rem;
+}
